<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThreeDEngine.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Phase R14f2 (TASK-0229): the APK of the phone holds this assembly, so the analyzer of platform compatibility (CA1416)
       refuses an API that Android does not have. The third run of the emulator ended on Console.ForegroundColor. -->
  <ItemGroup>
    <SupportedPlatform Include="android" />
  </ItemGroup>
</Project>
