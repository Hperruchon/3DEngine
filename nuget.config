<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local folder feed for the native packages that the project builds itself (TASK-0012 §6), accepted
    by the owner on 2026-11-09 in R-0007: Engine.Geometry.Manifold.Native and Engine.Native.DearImGui.
    nuget.org still applies for all other packages (sources merge across the config hierarchy unless
    <clear/> is used). A real feed comes beside this folder when a person outside this repository builds.
  -->
  <packageSources>
    <add key="manifold-local" value="nuget" />
  </packageSources>
</configuration>
