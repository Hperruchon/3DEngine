<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Contracts\Engine.Contracts.csproj" />
    <!-- ADR-0058 item 1 (phase K4b, TASK-0184): the engine reads the owned kernel for the faces of a body. -->
    <ProjectReference Include="..\Engine.Kernel\Engine.Kernel.csproj" />
  </ItemGroup>

  <!-- ADR-0015 (TASK-0091): a test attaches a document file on a stream that fails. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>

  <!-- Phase R14f2 (TASK-0229): the APK of the phone holds this assembly, so the analyzer of platform compatibility (CA1416)
       refuses an API that Android does not have. The third run of the emulator ended on Console.ForegroundColor. -->
  <ItemGroup>
    <SupportedPlatform Include="android" />
  </ItemGroup>
</Project>
