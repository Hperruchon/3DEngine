<Project Sdk="Microsoft.NET.Sdk">

  <!-- The verification spike of the vision library (phase V0, ADR-0042, TASK-0145).
       This project references no project of the repository, and it holds the only
       pins of OpenCvSharp5 (ADR-0103, TASK-0318); DependencyDirectionGateTests holds the two rules. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>ThreeDEngine.VisionTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261018" />
  </ItemGroup>

  <!-- ADR-0042 item 2: one native payload for each platform, so that each runner
       restores one. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261018" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64.slim" Version="5.0.0.20261018" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp5.runtime.osx.arm64" Version="5.0.0.20261018" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
