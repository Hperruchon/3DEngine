<Project Sdk="Microsoft.NET.Sdk">

  <!-- The judge of the write set (TASK-0053). The pipeline builds it from main,
       so it references no other project of the repository: it must build alone
       from a checkout of main. Engine.Tests references it for the reader of the
       task files and for the tests of the rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>write-set-check</AssemblyName>
    <RootNamespace>WriteSetCheck</RootNamespace>
  </PropertyGroup>

</Project>
