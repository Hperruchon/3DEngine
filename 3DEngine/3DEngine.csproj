<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThreeDEngine.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The host names no package for Vulkan or for SDL. It receives both bindings
    through 3DEngine.Vulkan, which holds the only pin of each one (ADR-0017).
  -->
  <ItemGroup>
    <ProjectReference Include="..\3DEngine.Core\3DEngine.Core.csproj" />
    <ProjectReference Include="..\3DEngine.Vulkan\3DEngine.Vulkan.csproj" />
  </ItemGroup>

</Project>
