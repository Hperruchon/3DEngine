<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThreeDEngine.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The host names no package for Vulkan or for SDL. It receives both bindings
    through 3DEngine.Vulkan, which holds the only pin of each one (ADR-0017).
  -->
  <ItemGroup>
    <ProjectReference Include="..\3DEngine.Core\3DEngine.Core.csproj" />
    <ProjectReference Include="..\3DEngine.Vulkan\3DEngine.Vulkan.csproj" />
  </ItemGroup>

  <!--
    The library of the user interface (ADR-0027 item 1, TASK-0084). This line is its only
    pin, and only the files in Ui/ name its namespace; UiLibraryGateTests holds both rules.
  -->
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <!--
    The desktop owns a document session and mounts the surface library on it (ADR-0019,
    TASK-0054). It is a composition root, so it may name the native backend (ADR-0014 §4).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The image test reads the renderer and the projection of the bodies of the host
       (ADR-0025 item 3, TASK-0076). -->
  <ItemGroup>
    <InternalsVisibleTo Include="3DEngine.ImageTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Api.Http\Engine.Api.Http.csproj" />
    <ProjectReference Include="..\Engine.Contracts\Engine.Contracts.csproj" />
    <ProjectReference Include="..\Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="..\Engine.Geometry.Manifold\Engine.Geometry.Manifold.csproj" />
  </ItemGroup>

</Project>
