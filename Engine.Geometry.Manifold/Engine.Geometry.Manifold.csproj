<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- [LibraryImport] source-generation needs unsafe (ADR-0014 §1 anticipated this). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      RID-agnostic per ADR-0014 §5: NO RuntimeIdentifier(s) here. The native
      `manifoldc` payload is consumed via runtimes/<rid>/native at publish/run.
      References only Engine.Contracts (ADR-0014 §4) — native deps stay out of
      Engine.Core.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Contracts\Engine.Contracts.csproj" />
    <!-- Native Manifold payload: runtimes/<rid>/native/manifoldc (ADR-0014 §5). -->
    <PackageReference Include="Engine.Geometry.Manifold.Native" Version="3.5.2.2" />
  </ItemGroup>

  <!-- Phase R14f2 (TASK-0229): the APK of the phone holds this assembly, so the analyzer of platform compatibility (CA1416)
       refuses an API that Android does not have. The third run of the emulator ended on Console.ForegroundColor. -->
  <ItemGroup>
    <SupportedPlatform Include="android" />
  </ItemGroup>
</Project>
