<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The first-party Vulkan layer. ADR-0017 gives the rules:
    - It references no Engine.* project. Only a host that draws references it.
    - This file holds the only pin of the Vulkan binding and of the SDL binding.
      A host receives both through its reference to this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThreeDEngine.Vulkan</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The compiled shaders (ADR-0022). Shaders/compile.js makes each .spv file and
       Shaders/shaders.lock; ShaderLibrary reads each one as a resource. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders/*.spv" LogicalName="Shaders/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The draw list of the render kernel (ADR-0023 item 4). ADR-0017 item 2 permits
         this reference and no other project reference. -->
    <ProjectReference Include="../3DEngine.Core/3DEngine.Core.csproj" />
  </ItemGroup>

  <!-- Phase R14f2 (TASK-0229): the APK of the phone holds this assembly, so the analyzer of platform compatibility (CA1416)
       refuses an API that Android does not have. The third run of the emulator ended on Console.ForegroundColor. -->
  <ItemGroup>
    <SupportedPlatform Include="android" />
  </ItemGroup>
</Project>
